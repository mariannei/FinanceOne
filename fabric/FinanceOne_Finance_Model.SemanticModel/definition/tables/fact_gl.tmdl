table fact_gl
	lineageTag: d30594e1-5b87-4fc3-b56f-f3b2e025a7ca
	sourceLineageTag: [dbo].[fact_gl]

	measure 'Total Debit' =
			
			SUM ( fact_gl[debit_amount] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 9521e233-a10d-4f72-a647-06a567939e9a

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Credit' =
			
			SUM ( fact_gl[credit_amount] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 98617f7e-0113-438d-90b5-3f62162bc195

		changedProperty = Name

		changedProperty = IsHidden

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Net Amount' =
			
			SUM ( fact_gl[signed_amount] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 6dc68180-6cc8-4cf8-b3cf-75a2683d9b7d

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Journal Line Count' =
			
			COUNTROWS ( fact_gl )
		formatString: #,0
		lineageTag: f6b94e73-1d08-45c6-b6cf-3f0ef4232dcc

		changedProperty = Name

		changedProperty = FormatString

	measure 'Journal Count' =
			
			DISTINCTCOUNT ( fact_gl[journal_id] )
		formatString: #,0
		lineageTag: 27e5197d-beaf-4c0f-88c8-05cf5111b01c

		changedProperty = Name

		changedProperty = FormatString

	measure Revenue =
			
			CALCULATE (
			    -[Net Amount],
			    dim_account[financial_statement] = "Income Statement",
			    dim_account[account_type] = "Revenue"
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 6a0209f8-72b0-4d01-8ac4-3b5862600527

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure Expenses = ```
			
			CALCULATE (
			    [Net Amount],
			    dim_account[financial_statement] = "Income Statement",
			    dim_account[account_type] = "Expense"
			) 
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: c6d6ed72-5ef9-4c57-8eb4-51d76cabadb3

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Net Income' =
			
			[Revenue] - [Expenses]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 3b908b33-db3e-423a-a602-931b38e4fd3d

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'P&L Amount' =
			
			VAR AccountType =
			    SELECTEDVALUE ( dim_account[account_type] )
			RETURN
			    IF (
			        ISINSCOPE ( dim_account[account_name] ),
			        SWITCH (
			            AccountType,
			            "Revenue", -[Net Amount],
			            "Expense", [Net Amount],
			            BLANK()
			        ),
			        [Net Income]
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 4b0de8d0-173c-4177-b757-fd53b5b00507

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Actual Revenue To Date' =
			
			CALCULATE (
			    [Revenue],
			    FILTER (
			        ALL ( dim_fiscal_period ),
			        dim_fiscal_period[fiscal_year] = 2026
			            && dim_fiscal_period[fiscal_period] <= 8
			    )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 2d58122a-4f7c-4d0b-af96-f611593d614a

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Actual Expenses To Date' = ```
			
			CALCULATE (
			    [Expenses],
			    FILTER (
			        ALL ( dim_fiscal_period ),
			        dim_fiscal_period[fiscal_year] = 2026
			            && dim_fiscal_period[fiscal_period] <= 8
			    )
			)
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 56ec0851-a02d-459f-9d4e-a52276da4c56

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

