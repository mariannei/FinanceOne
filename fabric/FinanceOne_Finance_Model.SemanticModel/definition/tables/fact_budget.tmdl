table fact_budget
	lineageTag: bc6f60cb-1076-4e94-8673-33162d7adaa3
	sourceLineageTag: [dbo].[fact_budget]

	measure Budget =
			
			SUM ( fact_budget[budget_amount] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 7482227c-78ae-4103-b29f-0a4d0df4dd46

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue Budget' =
			
			CALCULATE (
			    [Budget],
			    dim_account[account_type] = "Revenue"
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: f9084aab-42b4-4f60-86ee-ff150036e138

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Expense Budget' =
			
			CALCULATE (
			    [Budget],
			    dim_account[account_type] = "Expense"
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 68fb6d73-8fdd-4437-a553-a7198907c714

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue Variance' =
			
			[Revenue] - [Revenue Budget]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 30ad5821-7ed0-4dc6-a41d-f57ae697f793

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue Variance %' =
			
			DIVIDE (
			    [Revenue Variance],
			    [Revenue Budget]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c98c39f3-568d-4e6e-9edd-4caaa81057c3

		changedProperty = Name

		changedProperty = FormatString

	measure 'Expense Variance' =
			
			[Expense Budget] - [Expenses]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 5b98c21a-867b-45f1-842c-1b2230d487fb

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Expense Variance %' =
			
			DIVIDE (
			    [Expense Variance],
			    [Expense Budget]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 89c4c1d1-5d50-4d46-a724-4ff0b3bfe93f

		changedProperty = Name

		changedProperty = FormatString

	measure 'Revenue Budget P8-P12' =
			
			CALCULATE (
			    [Revenue Budget],
			    FILTER (
			        ALL ( dim_fiscal_period ),
			        dim_fiscal_period[fiscal_year] = 2026
			            && dim_fiscal_period[fiscal_period] >= 8
			    )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: fe3e894e-18cf-4479-801d-9f426dfe1f97

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Expense Budget P8-P12' =
			
			CALCULATE (
			    [Expense Budget],
			    FILTER (
			        ALL ( dim_fiscal_period ),
			        dim_fiscal_period[fiscal_year] = 2026
			            && dim_fiscal_period[fiscal_period] >= 8
			    )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: ecd1e3b7-32ce-447c-884c-584dc325fcb6

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

