table fact_forecast
	lineageTag: 06da3408-497a-4f3b-aa7f-098b2891527b
	sourceLineageTag: [dbo].[fact_forecast]

	measure Forecast =
			
			SUM ( fact_forecast[forecast_amount] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: af2db887-a4c1-4b64-b1b5-14861a908d47

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue Forecast' =
			
			CALCULATE (
			    [Forecast],
			    dim_account[account_type] = "Revenue"
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: eff45026-1ce8-4f5c-a175-d52d4f0c4735

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Expense Forecast' =
			
			CALCULATE (
			    [Forecast],
			    dim_account[account_type] = "Expense"
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: c46d3275-3500-468e-8f77-7a8ae429fd22

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue vs Forecast' =
			
			[Revenue] - [Revenue Forecast]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: ac061715-9307-4868-93b2-7e098689e753

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue vs Forecast %' =
			
			DIVIDE (
			    [Revenue vs Forecast],
			    [Revenue Forecast]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: df08584f-56a3-4b24-8aaf-74e3f2cab2f9

		changedProperty = Name

		changedProperty = FormatString

	measure 'Expense vs Forecast' =
			
			[Expense Forecast] - [Expenses]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: b25f1046-5a72-4366-b0bb-e91f97233a6f

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Expense vs Forecast %' =
			
			DIVIDE (
			    [Expense vs Forecast],
			    [Expense Forecast]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 17685549-6f77-4065-bb0e-00bb19809da9

		changedProperty = Name

		changedProperty = FormatString

	measure 'Revenue Forecast vs Budget' =
			
			[Revenue Forecast] - [Revenue Budget]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 73ee13ab-c857-4e98-ac5a-9676d1beef0f

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue Forecast vs Budget %' =
			
			DIVIDE (
			    [Revenue Forecast vs Budget],
			    [Revenue Budget]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 26e467d7-4072-40a7-ad10-679f09c43188

		changedProperty = Name

		changedProperty = FormatString

	measure 'Expense Forecast vs Budget' =
			
			[Expense Budget] - [Expense Forecast]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 3e9ffa61-d126-4295-926b-af7fdecb81f7

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Expense Forecast vs Budget %' =
			
			DIVIDE (
			    [Expense Forecast vs Budget],
			    [Expense Budget]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 87b97be4-703a-4f5a-8f3f-cc3b43b04b8a

		changedProperty = Name

		changedProperty = FormatString

	measure 'Remaining Revenue Forecast' =
			
			CALCULATE (
			    [Revenue Forecast],
			    FILTER (
			        ALL ( dim_fiscal_period ),
			        dim_fiscal_period[fiscal_year] = 2026
			            && dim_fiscal_period[fiscal_period] > 8
			    )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: db0433ea-4076-4895-801e-73f14de1058f

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Remaining Expense Forecast' =
			
			CALCULATE (
			    [Expense Forecast],
			    FILTER (
			        ALL ( dim_fiscal_period ),
			        dim_fiscal_period[fiscal_year] = 2026
			            && dim_fiscal_period[fiscal_period] > 8
			    )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 86b9ea5e-ef75-4c9e-9c82-bbc506ccd0a4

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue Full Year Outlook' =
			
			[Actual Revenue To Date] + [Remaining Revenue Forecast]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: efeb850a-22cd-4d9c-aa25-b7c06b04c3d0

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Expense Full Year Outlook' =
			
			[Actual Expenses To Date] + [Remaining Expense Forecast]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 003a5675-6d15-46b2-8c1b-f147b6dd77f3

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue Outlook Variance' =
			
			[Revenue Full Year Outlook] - [Revenue Budget P8-P12]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: e6af5757-3985-429f-9e21-14baaa68e7c1

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Expense Outlook Variance' =
			
			[Expense Budget P8-P12] - [Expense Full Year Outlook]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: cc97b0d5-293f-4f5f-82d4-fda2ad8447b9

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Full Year Budget Comparison' =
			
			SWITCH (
			    SELECTEDVALUE ( 'Financial Metric'[Metric] ),
			    "Revenue", [Revenue Budget P8-P12],
			    "Expenses", [Expense Budget P8-P12],
			    BLANK()
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 2ed8416e-565b-4ba7-b259-ac7f241d7bdb

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Full Year Outlook Comparison' =
			
			SWITCH (
			    SELECTEDVALUE ( 'Financial Metric'[Metric] ),
			    "Revenue", [Revenue Full Year Outlook],
			    "Expenses", [Expense Full Year Outlook],
			    BLANK()
			)
		lineageTag: 17c5c11a-80b2-47cc-b131-4c256051a6c3

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

