table dim_entity
	lineageTag: 3e8a1fde-82d0-4e54-acb5-e6283a8d1912
	sourceLineageTag: [dbo].[dim_entity]

	measure 'Show Entity for Selected Location' =
			
			VAR SelectedLocationEntity =
			    SELECTEDVALUE ( dim_location[entity_code] )
			VAR CurrentEntity =
			    SELECTEDVALUE ( dim_entity[entity_code] )
			RETURN
			    IF (
			        ISBLANK ( SelectedLocationEntity )
			            || CurrentEntity = SelectedLocationEntity,
			        1,
			        0
			    )
		formatString: 0
		lineageTag: a7971ac4-835c-4827-8d77-b7237d3138cb

		changedProperty = Name

	column entity_id
		dataType: string
		lineageTag: 85d0d9d0-274c-4035-b560-108580b7b27f
