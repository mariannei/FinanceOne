table dim_location
	lineageTag: b4458fb3-610b-4d3e-8cd7-28d1549fd8ba
	sourceLineageTag: [dbo].[dim_location]

	measure 'Show Location for Selected Entity' =
			
			VAR SelectedEntity =
			    SELECTEDVALUE ( dim_entity[entity_code] )
			VAR LocationEntity =
			    SELECTEDVALUE ( dim_location[entity_code] )
			RETURN
			    IF (
			        ISBLANK ( SelectedEntity )
			            || SelectedEntity = LocationEntity,
			        1,
			        0
			    )
		formatString: 0
		lineageTag: cc3a5b8f-b09d-4bcb-bb48-e1b2dc305797

		changedProperty = Name

